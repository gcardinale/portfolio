---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL; // '/portfolio/' in fase 1, '/' con dominio custom

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// Copy della home — sorgente di riferimento anche in /content/home.md (vedi CLAUDE.md).
const competenze: { titolo: string; voci: string[] }[] = [
  { titolo: 'Backend .NET', voci: ['C# 13', '.NET 10', 'ASP.NET Core MVC', 'Blazor (Server + WASM)', 'Entity Framework Core / LINQ', 'OData', 'Hangfire', 'API REST (Swagger/OpenAPI)'] },
  { titolo: 'Database', voci: ['SQL Server', 'MySQL / MariaDB', 'Redis', 'SQLite', 'schema design, query tuning', 'calcoli lato DB (stored functions, trigger)'] },
  { titolo: 'Cloud & Platform', voci: ['Azure (Container Apps, IoT Hub, Entra ID, Key Vault, Blob, Face API)', 'IaC (Bicep)', 'Kubernetes self-hosted', 'Docker'] },
  { titolo: 'Architettura', voci: ['Modular monolith', 'Clean Architecture', 'CQRS', 'DDD', '4-layer per modulo', 'multi-tenant', 'event-driven'] },
  { titolo: 'AI / LLM', voci: ['Claude / Anthropic API', 'MCP', 'analisi, code review, documentazione', 'ML in produzione (classificazione testuale, fine-tuning vision)'] },
  { titolo: 'Altro', voci: ['Flutter', 'Xamarin / MAUI', 'Node.js / TypeScript', 'firma digitale eIDAS', 'GDPR / NIS2 by design', 'CI/CD (GitHub Actions, Azure DevOps)', 'Agile (Scrum / Kanban)', 'inglese tecnico'] },
];

const esperienza: [string, string, string][] = [
  ['2026 – oggi', 'Fractional CTO (consulente)', 'ente partecipato pubblico, settore utility — consulenza tecnica continuativa, sicurezza e dati'],
  ['2025 – oggi', 'Software & Platform Engineer', 'settore automotive / telematica veicolare — piattaforma Fleet Management & IoT'],
  ['2019 – oggi', 'Software Architect (freelance)', 'associazione di tutela dei consumatori — piattaforma legal-tech'],
  ['2023 – 2025', 'IT Manager & Software Architect', 'settore trasporti e logistica — Azure, Blazor, piattaforma enterprise'],
  ['2023 – 2025', 'Software & Infrastructure Architect (freelance)', 'settore sanitario — piattaforma SaaS di telemedicina, Kubernetes'],
  ['2020 – 2023', 'ML Engineer & Software Engineer (freelance)', 'settore tech — ASR realtime, mobile, infrastruttura mail'],
  ['2016 – 2023', 'Fondatore & Direttore', 'ISP wireless territoriale — network engineering, RADIUS, BGP/OSPF'],
  ['2002 – 2016', 'Consulente IT indipendente', 'sviluppo software, networking, Pubblica Amministrazione'],
];

const about = [
  "Sviluppo software dal 2002: consulenza indipendente su progetti eterogenei, sette anni alla guida di un ISP wireless territoriale, poi backend .NET e architettura di sistema su piattaforme enterprise, IoT e legal-tech.",
  "Oggi porto questa esperienza dentro le PMI e gli enti: capire dove l'AI serve davvero, costruirla con un metodo verificabile e, dove esistono, finanziarla con le misure pubbliche. Lavoro come direzione tecnica esterna continuativa (Fractional CTO) oppure su progetti circoscritti.",
  "Il codice resta testabile e documentato per default. Dal 2024 uso quotidianamente strumenti AI/LLM nel ciclo di sviluppo e ho portato in produzione modelli di machine learning \"classici\" e fine-tuning di modelli vision.",
  "Sono a Reggio Calabria e lavoro da remoto, con presenza in sede quando serve.",
];

const offerta: { titolo: string; testo: string }[] = [
  { titolo: "AI dentro l'azienda", testo: "Individuo i processi in cui l'AI produce un risultato misurabile e li realizzo: automazione di documenti e flussi, analisi dei dati, assistenti interni con fonti controllate." },
  { titolo: "Progetti finanziati", testo: "Cerco le misure pubbliche (nazionali e regionali) compatibili con il progetto e preparo la documentazione, in modo che l'investimento non gravi interamente sul bilancio." },
  { titolo: "Fractional CTO", testo: "Direzione tecnica esterna continuativa: strategia IT, governo dei fornitori, sicurezza e conformità (NIS2, GDPR), architettura dei dati e del software." },
];

const metodo: { titolo: string; testo: string }[] = [
  { titolo: "Profilo", testo: "Si parte dall'azienda: settore, dimensione, sede, investimenti in programma, vincoli. Senza un profilo preciso ogni ricerca è generica." },
  { titolo: "Ricerca in parallelo su fonti ufficiali", testo: "Più linee di ricerca indipendenti, ciascuna ancorata a fonti primarie: bandi, norme, atti degli enti. Niente sentito dire." },
  { titolo: "Verifica indipendente", testo: "Ogni dato rilevante viene ricontrollato da un secondo passaggio separato dal primo, che deve ritrovare la fonte. Ciò che non regge viene scartato." },
  { titolo: "Selezione ragionata", testo: "Si tengono le opzioni davvero percorribili. Le altre restano nel documento con il motivo dell'esclusione, così la scelta è ripercorribile." },
  { titolo: "Documenti pronti", testo: "Il risultato è un set di documenti utilizzabili: schede, scadenze, requisiti, passi successivi. Non una presentazione da interpretare." },
];

const pageTitle = 'Consulenza AI e software per le PMI · Fractional CTO — Gaetano Luigi Matteo Cardinale';
const pageDesc = "Consulenza AI e software per le PMI: portare l'AI in azienda con un metodo verificabile, progetti finanziati con le misure pubbliche, Fractional CTO. 23 anni di esperienza .NET e Azure.";
---
<Base title={pageTitle} description={pageDesc}>
  <!-- HERO -->
  <header class="hero">
    <div class="wrap">
      <p class="brand"><img src={`${base}logo-gc.svg`} alt="" width="36" height="36" /> Gaetano Luigi Matteo Cardinale</p>
      <h1>Consulenza AI e software per le PMI</h1>
      <p class="role">Fractional CTO</p>
      <p class="tagline">
        Porto l'intelligenza artificiale dentro le aziende con un metodo in cui ogni dato ha una fonte
        primaria e una verifica indipendente: il "secondo cervello aziendale". Dove possibile, il progetto
        si finanzia con le misure pubbliche.
      </p>
      <div class="contacts">
        <a href="mailto:gcardinale@protonmail.com">✉ gcardinale@protonmail.com</a>
        <a href="tel:+393277549296">☎ +39 327 754 9296</a>
        <a class="ghost" href="https://www.linkedin.com/in/gaetano-cardinale-81350a17a/" target="_blank" rel="noopener">in LinkedIn</a>
      </div>
      <p class="note">Alle spalle 23 anni di sviluppo software (.NET, Azure). CV completo su richiesta.</p>
    </div>
  </header>

  <!-- COSA FACCIO -->
  <section class="section section--alt">
    <div class="wrap">
      <p class="eyebrow">Cosa faccio</p>
      <div class="steps cols">
        {offerta.map((o) => (
          <div class="step">
            <h3>{o.titolo}</h3>
            <p>{o.testo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COME LAVORO -->
  <section class="section" id="come-lavoro">
    <div class="wrap">
      <p class="eyebrow">Come lavoro</p>
      <p style="margin-top:0;">Lo stesso metodo vale per la ricerca di incentivi e per l'analisi tecnica: si parte dai fatti, si controllano, si motiva ogni scelta.</p>
      <ol class="steps">
        {metodo.map((m) => (
          <li class="step">
            <h3>{m.titolo}</h3>
            <p>{m.testo}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CHI SONO -->
  <section class="section section--alt">
    <div class="wrap prose">
      <p class="eyebrow">Chi sono</p>
      {about.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <!-- COMPETENZE -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Competenze</p>
      <div class="skills">
        {competenze.map((c) => (
          <div>
            <h3>{c.titolo}</h3>
            <div class="pills">{c.voci.map((v) => <span class="pill">{v}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROGETTI -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Progetti selezionati</p>
      <p class="note" style="margin-bottom:20px;">Per riservatezza i nomi dei committenti non sono riportati: si indica il settore.</p>
      <div class="cards">
        {projects.map((p) => (
          <article class="card">
            <a class="card-link" href={`${base}progetti/${p.id}/`}>
              <h3>{p.data.title}</h3>
              <p class="meta">{p.data.sector} · {p.data.period} · {p.data.role}</p>
              <p class="summary">{p.data.summary}</p>
              <div class="pills" style="margin-bottom:14px;">
                {p.data.stack.slice(0, 6).map((s) => <span class="pill">{s}</span>)}
              </div>
              <span class="more">Leggi il caso →</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ESPERIENZA -->
  <section class="section section--alt">
    <div class="wrap">
      <p class="eyebrow">Esperienza</p>
      <ul class="exp">
        {esperienza.map(([when, what, where]) => (
          <li>
            <span class="when">{when}</span>
            <span class="what"><strong>{what}</strong><span>{where}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CONTATTI -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Contatti</p>
      <p>Per capire se e dove l'AI può servire alla tua azienda, scrivimi o chiamami:</p>
      <div class="contacts">
        <a href="mailto:gcardinale@protonmail.com">✉ gcardinale@protonmail.com</a>
        <a href="tel:+393277549296">☎ +39 327 754 9296</a>
        <a class="ghost" href="https://www.linkedin.com/in/gaetano-cardinale-81350a17a/" target="_blank" rel="noopener">in LinkedIn</a>
      </div>
      <p class="note">Il CV completo si invia su richiesta.</p>
    </div>
  </section>

  <SiteFooter />
</Base>
